{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug xv6 (Remote)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/kernel/kernel",
            "args": [],
            "stopAtEntry": true,
            "cwd": "${workspaceFolder}",  // [修改点1] 确保工作目录永远是项目根目录
            "miDebuggerServerAddress": "localhost:26000",
            "miDebuggerPath": "/usr/bin/gdb-multiarch",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "为 gdb 启用整齐打印",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "允许加载项目根目录的 .gdbinit 文件", 
                    "text": "-gdb-set auto-load safe-path /",  // [修改点2] 核心！解决断点灰色和变量无法显示的问题
                    "ignoreFailures": true
                },
                {
                    "description": "将反汇编风格设置为 Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}